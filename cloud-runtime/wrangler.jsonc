{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fi-acquisition-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],

  // --- Browser Run (Browser Automation API) ---
  // For JS-rendered pages and structured quick actions (/content, /scrape).
  "browser": {
    "binding": "BROWSER"
  },

  // --- Cron Trigger (production scheduler) ---
  // One-minute wake-up. The planner is the cadence/quota authority; this is
  // only the master clock and never means every source is fetched every minute.
  "triggers": {
    "crons": ["* * * * *"]
  },

  // --- Queues ---
  // FAST: max_batch_size=1, max_concurrency=1 to serialize Monid calls
  // and avoid 502 rate limits. Short batch timeout so tasks process promptly.
  "queues": {
    "producers": [
      { "queue": "fi-youtube", "binding": "YOUTUBE_QUEUE" },
      { "queue": "fi-structured-api", "binding": "STRUCTURED_API_QUEUE" },
      { "queue": "fi-browser", "binding": "BROWSER_QUEUE" },
      { "queue": "fi-monid", "binding": "MONID_QUEUE" },
      { "queue": "fi-processing", "binding": "PROCESSING_QUEUE" },
      { "queue": "fi-dlq", "binding": "DLQ_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "fi-youtube",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 10,
        "dead_letter_queue": "fi-dlq",
        "retry_delay": 30
      },
      {
        "queue": "fi-structured-api",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "max_concurrency": 1,
        "dead_letter_queue": "fi-dlq",
        "retry_delay": 30
      },
      {
        "queue": "fi-browser",
        "max_batch_size": 2,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "max_concurrency": 2,
        "dead_letter_queue": "fi-dlq"
      },
      {
        "queue": "fi-monid",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1,
        "dead_letter_queue": "fi-dlq",
        "retry_delay": 15
      },
      {
        "queue": "fi-processing",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 5,
        "max_concurrency": 5,
        "dead_letter_queue": "fi-dlq"
      },
      {
        "queue": "fi-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 10,
        "max_retries": 100,
        "max_concurrency": 1
      }
    ]
  },

  // --- R2 Buckets ---
  "r2_buckets": [
    { "binding": "RAW_BUCKET", "bucket_name": "festival-intelligence-raw" },
    { "binding": "LAKE_BUCKET", "bucket_name": "festival-intelligence-lake" },
    { "binding": "BACKUP_BUCKET", "bucket_name": "festival-intelligence-backups" }
  ],

  // --- Durable Objects ---
  "durable_objects": {
    "bindings": [
      {
        "name": "GOVERNOR",
        "class_name": "AcquisitionGovernor"
      },
      {
        "name": "ACQUISITION_CONTAINER",
        "class_name": "AcquisitionContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AcquisitionGovernor", "AcquisitionContainer"]
    }
  ],

  // --- Containers (deferred — not on critical path for FAST-only pilot) ---
  // Containers section removed from deploy — native Worker Monid fetch is the production path.
  // Container DO still exported for future use.

  // --- Workflow ---
  "workflows": [
    {
      "name": "fi-acquisition-workflow",
      "binding": "ACQUISITION_WORKFLOW",
      "class_name": "AcquisitionWorkflow",
      // Schedule enabled after initial deployment
      // "schedules": ["*/15 * * * *"]
    }
  ],

  // --- Environment Variables (non-secret) ---
  "vars": {
    "POLICY_VERSION": "1.0.0",
    "SOFTWARE_VERSION": "cloud-forward-data-plane-v2",
    // Budget policy — AUTOMATED caps
    // Monid balance ≈ $10.90. Reserve for failures/mapping/manual research.
    "DAILY_BUDGET_USD": "0.25",
    "MONTHLY_BUDGET_USD": "7.50",
    // Official YouTube Data API daily quota budget used by the deterministic
    // planner schedule (hot hourly + rotating cold daily allocation).
    "YOUTUBE_DAILY_QUOTA": "9000",
    // Absolute project hard stop
    "ABSOLUTE_HARD_STOP_USD": "10.00",
    "ENABLE_DEEP_RAIL": "false"
  }
}
