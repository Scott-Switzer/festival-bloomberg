{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Dedicated read-only terminal runtime. SEPARATE from fi-acquisition-runtime.
  // Responsibilities ONLY: static terminal assets + product container serving
  // the compact serving DuckDB artifact. NO acquisition admin API, NO provider
  // secrets, NO batch triggers, NO Gold materialization, NO warehouse mutation.
  "name": "festival-bloomberg-terminal",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // Static terminal assets are assembled into ./public by CI from
  // apps/terminal/mvp. The Worker never serves data from these files.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "env": {
    "staging": {
      "name": "festival-bloomberg-terminal-staging",
      "durable_objects": {
        "bindings": [
          { "name": "TERMINAL_CONTAINER", "class_name": "TerminalContainer" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["TerminalContainer"] }
      ],
      "r2_buckets": [
        { "binding": "LAKE_BUCKET", "bucket_name": "festival-intelligence-lake" }
      ],
      "containers": [
        {
          "class_name": "TerminalContainer",
          "image": "./docker/Dockerfile.terminal",
          "max_instances": 1,
          "instance_type": "standard-1"
        }
      ],
      "vars": {
        "TERMINAL_MODE": "STAGING_PUBLIC_DEMO",
        "POLICY_VERSION": "1.0.0",
        "SOFTWARE_VERSION": "artist-terminal-v1-staging"
      }
    },

    "production": {
      "name": "festival-bloomberg-terminal-production",
      "durable_objects": {
        "bindings": [
          { "name": "TERMINAL_CONTAINER", "class_name": "TerminalContainer" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["TerminalContainer"] }
      ],
      "r2_buckets": [
        { "binding": "LAKE_BUCKET", "bucket_name": "festival-intelligence-lake" }
      ],
      "containers": [
        {
          "class_name": "TerminalContainer",
          "image": "./docker/Dockerfile.terminal",
          "max_instances": 1,
          "instance_type": "standard-1"
        }
      ],
      "vars": {
        "TERMINAL_MODE": "PRODUCTION_PRIVATE",
        "POLICY_VERSION": "1.0.0",
        "SOFTWARE_VERSION": "artist-terminal-v1-production"
      }
    }
  }

  // No provider or acquisition secrets are present in this runtime. Production
  // authentication is supplied by Cloudflare Access in front of the Worker;
  // absent Access headers fail closed in src/index.ts.
}
