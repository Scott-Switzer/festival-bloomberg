# Festival Bloomberg — Terminal product container (READ-ONLY serving).
# Runs on Cloudflare Containers standard-1: 1 vCPU / 2 GiB RAM.
#
# Startup contract (terminal_entrypoint.py):
#   fetch CURRENT.json → stream terminal.duckdb → SHA-256 verify →
#   open READ_ONLY → serve mvp_server on port 8080.
#
# It NEVER rebuilds the warehouse, never touches raw/silver/gold, and carries
# no provider credentials.

FROM python:3.12-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first (layer caching)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the Python package
COPY python/ python/
ENV PYTHONPATH=/app/python

# Copy the static app as well as the entrypoint. The Worker serves these
# assets at the edge, but keeping them in the image makes the container
# self-contained for health/UAT and avoids a hidden development dependency.
COPY public/ public/
COPY terminal_entrypoint.py .

# Non-root user
RUN useradd -m -r term && chown -R term:term /app
USER term

HEALTHCHECK --interval=60s --timeout=15s --retries=3 \
    CMD python -c "import duckdb; print('terminal container healthy')" || exit 1

ENV PYTHONUNBUFFERED=1
ENV PRODUCT_SCRATCH_DIR=/tmp/festival-bloomberg-terminal
ENV PRODUCT_SERVING_PORT=8080

# Long-running product server. Cloudflare Containers DO fetch() routes
# /api/* and /health here.
EXPOSE 8080
CMD ["python", "/app/terminal_entrypoint.py"]
