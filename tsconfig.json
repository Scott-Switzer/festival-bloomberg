{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "types": ["node"]
  },
  "include": [
    "portfolio_metrics.ts",
    "calc_metrics.ts",
    "portfolio_validation.ts",
    "run_patched_backtest.ts",
    "backtest_runner.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
