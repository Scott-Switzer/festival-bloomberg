# Festival Bloomberg Required API Keys
NVIDIA_API_KEY=your_nvidia_api_key_here
# Alternative: OPENAI_API_KEY=your_openai_api_key_here
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# Optional API Keys
MUSICBRAINZ_USER_AGENT=festival-intelligence/1.0 (your-email@example.com)
SETLISTFM_API_KEY=your_setlistfm_api_key_here
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
BEA_API_KEY=your_bea_api_key_here
BLS_API_KEY=your_bls_api_key_here
MONID_API_KEY=your_monid_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
KAGGLE_API_KEY=your_kaggle_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/festival_intelligence

# Application
LOG_LEVEL=INFO
ENVIRONMENT=development
