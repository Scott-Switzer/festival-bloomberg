# Festival Bloomberg Environment Variables Configuration
# Copy this file to .env and fill in actual values for your environment

# Hetzner LLM API Configuration (Optional)
# HETZNER_VLLM_API_KEY=your_hetzner_api_key_here
# HETZNER_VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# Database Configuration
# DATABASE_URL=duckdb:///data/warehouse/festival_bloomberg.duckdb

# External API Keys (Optional - for data sources)
# MUSICBRAINZ_USER_AGENT=festival-bloomberg/1.0 (your-email@example.com)
# WIKIMEDIA_API_KEY=your_wikimedia_api_key_here
# GDELT_API_KEY=your_gdelt_api_key_here

# Ticketmaster API (Optional - subject to terms of use)
# TICKETMASTER_API_KEY=your_ticketmaster_api_key_here
# TICKETMASTER_API_SECRET=your_ticketmaster_api_secret_here

# Setlist.fm API (Optional)
# SETLISTFM_API_KEY=your_setlistfm_api_key_here

# YouTube Data API (Optional)
# YOUTUBE_API_KEY=your_youtube_api_key_here

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=localhost
API_PORT=8000