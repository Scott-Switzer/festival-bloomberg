# Festival Bloomberg Environment Configuration
# Copy this file to .env and fill in actual values
# DO NOT commit .env to version control

# Database Configuration
WAREHOUSE_PATH=./data/warehouse/festival_bloomberg.duckdb

# MusicBrainz API
MUSICBRAINZ_API_KEY=your_musicbrainz_api_key_here
MUSICBRAINZ_RATE_LIMIT=1.0

# Spotify API
# 2026 Dev Mode: single API key (spak_...) OR classic client id/secret.
SPOTIFY_API_KEY=
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Ticketing APIs
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here
TICKETMASTER_CONSUMER_KEY=your_ticketmaster_consumer_key_here

# External Data Sources
WIKIMEDIA_API_ENDPOINT=https://wikimedia.org/api/rest_v1
NEWS_API_KEY=your_news_api_key_here

# Data Flywheel context panel (keyed providers; registered in flywheel.source_registry)
CENSUS_API_KEY=your_census_api_key_here
BLS_API_KEY=your_bls_api_key_here
NOAA_API_TOKEN=your_noaa_api_token_here

# Intelligence/LLM Services
HETZNER_API_KEY=your_hetzner_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Signal Fabric acquisition providers (local development only)
# Values are read from the environment first, then this file (never committed).
YOUTUBE_API_KEY=
MONID_API_KEY=
APIFY_TOKEN=
SETLISTFM_API_KEY=
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=
NVIDIA_API_KEY=
MUSICBRAINZ_USER_AGENT=

# Cloudflare R2 Object Store (set FI_OBJECT_STORE=R2 to enable)
FI_OBJECT_STORE=local
FI_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
FI_R2_ACCESS_KEY_ID=
FI_R2_SECRET_ACCESS_KEY=
FI_R2_RAW_BUCKET=festival-intelligence-raw
FI_R2_LAKE_BUCKET=festival-intelligence-lake
FI_R2_BACKUP_BUCKET=festival-intelligence-backups

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_CONCURRENT_REQUESTS=10

# Security
SECRET_KEY=your_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here