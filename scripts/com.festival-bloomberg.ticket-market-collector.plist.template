<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.festival-bloomberg.ticket-market-collector</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>FB_HOME={{FB_HOME}} {{REPO_ROOT}}/scripts/ticket_market_collector_wrapper.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{REPO_ROOT}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>FB_HOME</key>
        <string>{{FB_HOME}}</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONPATH</key>
        <string>{{REPO_ROOT}}/python</string>
        <key>TICKET_MARKET_DEEP</key>
        <string>0</string>
        <key>TICKET_MARKET_MAX_COST</key>
        <string>2.00</string>
    </dict>

    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/ticket-market-collector.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/ticket-market-collector.stderr.log</string>

    <key>StartInterval</key>
    <integer>43200</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
